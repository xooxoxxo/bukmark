#!/bin/sh
# bukmark: set up and run your own bukmark server with Docker Compose.
#
# Everything lives in one folder, $BUKMARK_HOME (default ~/.bukmark):
#   compose.yml  written by this command on every run; do not edit it
#   .env         your settings; `bukmark setup` writes it once, then it is yours
#   backups/     database dumps `bukmark update` takes, for `bukmark rollback`
# The server runs from the published image, so nothing is built here.
#
# Docs: https://bukmark.it/docs/install/
set -eu

BUKMARK_CLI_VERSION=0.4.1

DEFAULT_IMAGE=ghcr.io/xooxoxxo/bukmark
DB_IMAGE=pgvector/pgvector:pg17
# Not "bukmark": Docker Compose names a source checkout's project after its
# folder, and the install guide clones into one called bukmark. Sharing that
# name would share containers and the database volume with it.
PROJECT=bukmark-cli
DIR=${BUKMARK_HOME:-$HOME/.bukmark}
COMPOSE_YML=$DIR/compose.yml
OVERRIDE_YML=$DIR/compose.override.yml
ENV_FILE=$DIR/.env
BACKUP_DIR=$DIR/backups
# What the last update replaced: the version that ran before it and the dump
# taken just before it. bukmark rollback goes back to both.
LAST_UPDATE=$BACKUP_DIR/last-update
# How many pre-update dumps to keep. A dump holds every bookmark, so a few
# are worth the disk; dozens are not.
KEEP_BACKUPS=5
WAIT_SECONDS=${BUKMARK_WAIT_SECONDS:-120}

# The server's settings come from $ENV_FILE and nowhere else. Compose lets the
# shell's environment win over .env, so a PORT or POSTGRES_PASSWORD exported
# for some other project would quietly change bukmark's. BUKMARK_VERSION and
# BUKMARK_IMAGE still pass through, to pick an image for one run.
unset POSTGRES_PASSWORD PORT BUKMARK_LISTEN TRUST_PROXY BUKMARK_EXTENSION_IDS BUKMARK_CHECK_PAGES BUKMARK_UPDATE_FEED \
  COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_PROFILES COMPOSE_ENV_FILES

say() { printf '%s\n' "$*"; }
warn() { printf 'bukmark: %s\n' "$*" >&2; }
die() {
  warn "$*"
  exit 1
}
die_usage() {
  warn "$*"
  warn "See: bukmark help"
  exit 2
}
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
bukmark $BUKMARK_CLI_VERSION: run your own bukmark server with Docker.

Usage: bukmark <command> [options]

Commands:
  setup [--port N]   Set up bukmark and start it. Safe to run again.
    --lan            Let other devices on your network reach it.
    --local          Only this machine again (the default).
  start              Start bukmark.
  stop               Stop bukmark. Your data is kept.
  restart            Restart bukmark, with any changes to .env.
  status             Show whether bukmark is running.
  logs [-f]          Show the server's logs. -f keeps following them.
  update             Back up the database, download the newest version and
                     restart. Your data is kept.
    --latest         Follow new releases again after a rollback.
  rollback           Undo the last update: the version and database from
                     before it. Changes since that update are lost.
    --yes            Roll back without asking.
  open               Open bukmark in your browser.
  uninstall          Remove bukmark's containers. Your data is kept.
    --delete-data    Also delete all bookmarks and settings, after asking.
    --yes            Delete without asking.
  version            Print this command's version.
  help               Show this help.

Settings: $ENV_FILE
Docs: https://bukmark.it/docs/install/
EOF
}

# Kept word for word the same in packaging/install.sh (a test checks).
require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    case $(uname -s) in
      Darwin) die "Docker is not installed. Install Docker Desktop, OrbStack or Colima, start it, and try again." ;;
      *) die "Docker is not installed. Install Docker Engine (https://docs.docker.com/engine/install/) and try again." ;;
    esac
  fi
  if ! docker_error=$(docker info 2>&1 >/dev/null); then
    case $docker_error in
      *"permission denied"*)
        die "Docker is running, but your user may not use it. Add yourself to the docker group (https://docs.docker.com/engine/install/linux-postinstall/), log in again, and try again." ;;
    esac
    case $(uname -s) in
      Darwin) die "Docker is not running. Start Docker Desktop, OrbStack or Colima (colima start), and try again." ;;
      *) die "Docker is not running. Start it (for example: sudo systemctl start docker) and try again." ;;
    esac
  fi
  if ! docker compose version >/dev/null 2>&1; then
    die "Docker Compose v2 is missing: \`docker compose\` does not work. Install the Compose plugin (https://docs.docker.com/compose/install/) and try again."
  fi
}

# docker compose, on bukmark's project and files, from any directory.
dc() {
  if [ -f "$OVERRIDE_YML" ]; then
    docker compose -p "$PROJECT" --project-directory "$DIR" -f "$COMPOSE_YML" -f "$OVERRIDE_YML" "$@"
  else
    docker compose -p "$PROJECT" --project-directory "$DIR" -f "$COMPOSE_YML" "$@"
  fi
}

# The value NAME has in .env, without quotes; empty when it has none.
env_get() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^[[:space:]]*$1=//p" "$ENV_FILE" | tail -n 1 |
    sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\\(.*\\)'\$/\\1/"
}

server_port() {
  p=$(env_get PORT)
  say "${p:-3000}"
}
server_url() { say "http://localhost:$(server_port)"; }

# 127.0.0.1 (this machine only, the default) or 0.0.0.0 (the network too).
listen_addr() {
  a=$(env_get BUKMARK_LISTEN)
  say "${a:-127.0.0.1}"
}

# Sets one setting in .env, keeping everything else as it is.
set_env() {
  tmp=$DIR/.env.tmp.$$
  (
    umask 077
    if grep -q "^$1=" "$ENV_FILE"; then
      sed "s|^$1=.*|$1=$2|" "$ENV_FILE" >"$tmp"
    else
      cat "$ENV_FILE" >"$tmp"
      printf '\n%s=%s\n' "$1" "$2" >>"$tmp"
    fi
  )
  mv "$tmp" "$ENV_FILE"
}

# The image the app runs, as compose resolves it: the environment, then .env.
app_image() {
  image=${BUKMARK_IMAGE:-$(env_get BUKMARK_IMAGE)}
  tag=${BUKMARK_VERSION:-$(env_get BUKMARK_VERSION)}
  say "${image:-$DEFAULT_IMAGE}:${tag:-latest}"
}

valid_port() {
  case $1 in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# True when URL answers with a 2xx. Status 2: no curl or wget to ask with.
http_ok() {
  if have curl; then
    curl -fsS -o /dev/null --max-time 3 "$1" 2>/dev/null
  elif have wget; then
    wget -q -T 3 -O /dev/null "$1" 2>/dev/null
  else
    return 2
  fi
}

# Prints what URL answers, when it answers with a 2xx.
http_get() {
  if have curl; then
    curl -fsS --max-time 3 "$1" 2>/dev/null
  elif have wget; then
    wget -q -T 3 -O - "$1" 2>/dev/null
  else
    return 2
  fi
}

# True when something already listens on PORT on this machine.
port_in_use() {
  if have curl; then
    # curl exits 7 when nothing listens. An answer, an error or a timeout
    # all mean something does.
    rc=0
    curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$1/" 2>/dev/null || rc=$?
    [ "$rc" -ne 7 ]
  elif have wget; then
    # wget has no exit status of its own for a refused connection.
    if LC_ALL=C wget -T 2 -O /dev/null "http://127.0.0.1:$1/" 2>&1 | grep -qi refused; then
      return 1
    fi
    return 0
  else
    return 1
  fi
}

app_running() {
  [ -n "$(dc ps -q --status running app 2>/dev/null)" ]
}

# Writes compose.yml, or leaves it alone when it is already current. It is
# rewritten on every run, so a new version of this command brings its own.
write_compose() {
  tmp=$DIR/.compose.yml.$$
  cat >"$tmp" <<'EOF'
# Written by the bukmark command, which rewrites it on every run: edit .env
# next to it instead. For a change .env cannot make, put it in
# compose.override.yml in this folder; bukmark loads that after this file.
name: bukmark
services:
  db:
    image: pgvector/pgvector:pg17
    environment:
      POSTGRES_USER: bukmark
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-}
      POSTGRES_DB: bukmark
    # No port on the host: only the app reaches the database, over the
    # compose network.
    volumes: [pgdata:/var/lib/postgresql/data]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U bukmark"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped
  app:
    image: ${BUKMARK_IMAGE:-ghcr.io/xooxoxxo/bukmark}:${BUKMARK_VERSION:-latest}
    environment:
      DATABASE_URL: postgres://bukmark:${POSTGRES_PASSWORD:-}@db:5432/bukmark
      PORT: 3000
      TRUST_PROXY: ${TRUST_PROXY:-false}
      BUKMARK_EXTENSION_IDS: ${BUKMARK_EXTENSION_IDS:-}
      BUKMARK_CHECK_PAGES: ${BUKMARK_CHECK_PAGES:-true}
      BUKMARK_UPDATE_FEED: ${BUKMARK_UPDATE_FEED:-}
      # Tells the app's Settings › Updates which update command to show.
      BUKMARK_INSTALL_METHOD: installer
    ports: ["${BUKMARK_LISTEN:-127.0.0.1}:${PORT:-3000}:3000"]
    depends_on:
      db: { condition: service_healthy }
    restart: unless-stopped
volumes:
  pgdata:
EOF
  if [ -f "$COMPOSE_YML" ] && cmp -s "$tmp" "$COMPOSE_YML"; then
    rm -f "$tmp"
  else
    mv -f "$tmp" "$COMPOSE_YML"
  fi
}

random_password() {
  # 16 random bytes as 32 hex characters: safe in a URL and in .env as is.
  pw=$(od -An -tx1 -N16 /dev/urandom | tr -d ' \t\n')
  [ "${#pw}" -eq 32 ] || die "Could not make a password from /dev/urandom."
  say "$pw"
}

# Writes .env, readable by you alone. Never called when .env exists.
write_env() {
  password=$(random_password)
  tmp=$DIR/.env.tmp.$$
  (
    umask 077
    cat >"$tmp" <<EOF
# bukmark settings. After changing one, run: bukmark restart
# bukmark setup wrote this file once. Run again, it changes only
# BUKMARK_LISTEN, and only when you pass --lan or --local.

# Password of bukmark's database, made up at setup. The database has no port
# on this machine; only the app reaches it. The database keeps the password it
# started with, so changing it here locks the app out.
POSTGRES_PASSWORD=$password

# Port the web app and API are served on, on this machine.
PORT=$1

# Who can reach it: 127.0.0.1 is this machine only. 0.0.0.0 is every device
# that can reach this one, such as your phone on the same Wi-Fi; set your
# password before you open it up. Switch with: bukmark setup --lan (or --local)
BUKMARK_LISTEN=$2

# true only when a reverse proxy (nginx, Caddy, Traefik) is the only way to
# reach bukmark. See https://bukmark.it/docs/install/#behind-a-reverse-proxy
TRUST_PROXY=false

# Browser-extension builds the login page recognises, comma-separated.
# See https://bukmark.it/docs/extension/#unrecognised-extension
BUKMARK_EXTENSION_IDS=

# false stops the server fetching saved pages in the background.
# See https://bukmark.it/docs/install/#environment-variables
BUKMARK_CHECK_PAGES=true

# off stops checking GitHub for new bukmark releases.
# See https://bukmark.it/docs/privacy/#update-checks
BUKMARK_UPDATE_FEED=

# Server version to run: latest, or a release such as 0.3.0.
# bukmark update downloads the newest image for it.
BUKMARK_VERSION=${BUKMARK_VERSION:-latest}
EOF
    if [ -n "${BUKMARK_IMAGE:-}" ] && [ "$BUKMARK_IMAGE" != "$DEFAULT_IMAGE" ]; then
      printf '\n# Image to run instead of %s.\nBUKMARK_IMAGE=%s\n' "$DEFAULT_IMAGE" "$BUKMARK_IMAGE" >>"$tmp"
    fi
  )
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

no_options() {
  [ $# -eq 0 ] || die_usage "bukmark $cmd takes no options: $*"
}

require_setup() {
  [ -f "$ENV_FILE" ] || die "bukmark is not set up yet. Run: bukmark setup"
}

# Downloads the images. Returns 1 when that fails but copies of both are
# already on this machine; stops when there is nothing to run.
pull_images() {
  if dc pull; then
    return 0
  fi
  if docker image inspect "$(app_image)" "$DB_IMAGE" >/dev/null 2>&1; then
    warn "Could not download the newest images. Using the copies already on this machine."
    return 1
  fi
  die "Could not download the bukmark images. Check your internet connection and try again."
}

# Waits until the server answers, up to $WAIT_SECONDS.
wait_healthy() {
  health=http://127.0.0.1:$(server_port)/healthz
  if ! have curl && ! have wget; then
    warn "Neither curl nor wget is installed, so bukmark cannot check that the server started."
    return 0
  fi
  printf 'Waiting for bukmark to start...' >&2
  waited=0
  until http_ok "$health"; do
    if [ "$waited" -ge "$WAIT_SECONDS" ]; then
      printf '\n' >&2
      die "bukmark did not answer on $(server_url) within $WAIT_SECONDS seconds. See what happened: bukmark logs"
    fi
    printf '.' >&2
    sleep 2
    waited=$((waited + 2))
  done
  printf ' ready.\n' >&2
}

# Stops before starting when another program has the port.
check_port() {
  if ! app_running && port_in_use "$1"; then
    if [ "$2" = new ]; then
      next=$(($1 + 1))
      [ "$next" -le 65535 ] || next=3001
      die "Port $1 is already in use on this machine. Choose another: bukmark setup --port $next"
    fi
    die "Port $1 is already in use on this machine. Stop what uses it, or set another PORT in $ENV_FILE and run: bukmark start"
  fi
}

cmd_setup() {
  want_port=${BUKMARK_PORT:-}
  port_given=${BUKMARK_PORT:+x}
  want_listen=
  while [ $# -gt 0 ]; do
    case $1 in
      --lan)
        want_listen=0.0.0.0
        shift
        ;;
      --local)
        want_listen=127.0.0.1
        shift
        ;;
      --port)
        [ $# -ge 2 ] || die_usage "--port needs a port number."
        want_port=$2
        port_given=x
        shift 2
        ;;
      --port=*)
        want_port=${1#--port=}
        port_given=x
        shift
        ;;
      *) die_usage "Unknown option for setup: $1" ;;
    esac
  done
  if [ -n "$port_given" ] && ! valid_port "$want_port"; then
    die_usage "Not a port number: '$want_port'"
  fi

  require_docker
  (umask 077 && mkdir -p "$DIR")
  write_compose

  if [ -f "$ENV_FILE" ]; then
    port=$(server_port)
    if [ -n "$want_port" ] && [ "$want_port" != "$port" ]; then
      warn "Keeping port $port from $ENV_FILE, which setup never overwrites. To use port $want_port, change PORT there and run: bukmark restart"
    fi
    say "Using the settings in $ENV_FILE"
    if [ -n "$want_listen" ] && [ "$want_listen" != "$(listen_addr)" ]; then
      set_env BUKMARK_LISTEN "$want_listen"
      say "Set BUKMARK_LISTEN=$want_listen in $ENV_FILE"
    fi
    check_port "$port" existing
  else
    # A database from an earlier setup only opens with that setup's password,
    # which was in the .env that is gone.
    if docker volume inspect "${PROJECT}_pgdata" >/dev/null 2>&1; then
      die "Found bukmark data in the Docker volume ${PROJECT}_pgdata, but not $ENV_FILE, which holds its database password. Put that .env back to keep the data. To start over and delete that data for good: docker volume rm ${PROJECT}_pgdata"
    fi
    port=${want_port:-3000}
    check_port "$port" new
    write_env "$port" "${want_listen:-127.0.0.1}"
    say "Wrote your settings to $ENV_FILE"
  fi

  pull_images || true
  dc up -d --remove-orphans
  wait_healthy

  url=$(server_url)
  # Run again after the password is set, setup should not ask for it again.
  case $(http_get "http://127.0.0.1:$(server_port)/api/auth/status" || true) in
    *'"setupComplete":true'*) open_step="Open $url and log in." ;;
    *) open_step="Open $url and set your password." ;;
  esac
  if [ "$(listen_addr)" = 0.0.0.0 ]; then
    reach="Other devices on your network reach it at this machine's address, port $(server_port).
Set your password first: until then, anyone who can reach the port can set it."
  else
    reach="Only this machine can reach it. For your phone or other devices: bukmark setup --lan"
  fi
  cat <<EOF

bukmark is running at $url
$reach

Next:
  1. $open_step
  2. Install the browser extension: https://bukmark.it/docs/extension/
  3. In the extension, log in to $url

bukmark help lists the other commands.
EOF
}

cmd_start() {
  require_setup
  require_docker
  write_compose
  check_port "$(server_port)" existing
  dc up -d --remove-orphans
  wait_healthy
  say "bukmark is running at $(server_url)"
}

cmd_stop() {
  require_setup
  require_docker
  write_compose
  dc stop
  say "bukmark is stopped. Your data is kept. Start it again: bukmark start"
}

cmd_restart() {
  require_setup
  require_docker
  write_compose
  dc stop
  # PORT in .env may have changed to one another program has.
  check_port "$(server_port)" existing
  dc up -d --remove-orphans
  wait_healthy
  say "bukmark is running at $(server_url)"
}

cmd_status() {
  if [ ! -f "$ENV_FILE" ]; then
    say "bukmark is not set up. Run: bukmark setup"
    exit 3
  fi
  require_docker
  write_compose
  dc ps
  say ""
  # Ask Docker first: another program may answer on the same port.
  if ! app_running; then
    say "bukmark is stopped. Start it: bukmark start"
    exit 3
  fi
  if http_ok "http://127.0.0.1:$(server_port)/healthz"; then
    say "bukmark is running at $(server_url)"
  else
    say "bukmark is starting, or not answering at $(server_url). See: bukmark logs"
    exit 1
  fi
}

cmd_logs() {
  require_setup
  require_docker
  write_compose
  dc logs "$@"
}

image_id() {
  docker image inspect --format '{{.Id}}' "$1" 2>/dev/null || true
}

db_running() {
  [ -n "$(dc ps -q --status running db 2>/dev/null)" ]
}

# The id of the image the app runs now: its container's, or, when it is not
# running, what the app's tag points at on this machine.
running_image_id() {
  cid=$(dc ps -q app 2>/dev/null || true)
  if [ -n "$cid" ]; then
    docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true
  else
    image_id "$(app_image)"
  fi
}

# The release the app runs now, from the image's
# org.opencontainers.image.version label; empty when that is unknown, as for
# a build made on this machine. Asked before pulling, since a pull moves a
# floating tag such as latest on to the next release.
running_version() {
  format='{{index .Config.Labels "org.opencontainers.image.version"}}'
  cid=$(dc ps -q app 2>/dev/null || true)
  if [ -n "$cid" ]; then
    v=$(docker inspect --format "$format" "$cid" 2>/dev/null || true)
  else
    v=$(docker image inspect --format "$format" "$(app_image)" 2>/dev/null || true)
  fi
  # "dev" is a development build: there is no published image to go back to.
  case $v in
    '' | dev | '<no value>' | *[!A-Za-z0-9._-]*) v= ;;
  esac
  say "$v"
}

# Dumps the database to $1 in pg_dump's custom format, with the database
# container's own pg_dump (it always matches the server), then reads it back
# with pg_restore --list. $POSTGRES_USER and $POSTGRES_DB expand inside the
# container, so a database renamed in compose.override.yml works too.
backup_database() {
  dump=$1
  (umask 077 && mkdir -p "$BACKUP_DIR")
  chmod 700 "$BACKUP_DIR"
  if ! db_running; then
    # A stopped bukmark still has its data. Start just the database to save it.
    dc up -d --wait db || return 1
  fi
  say "Backing up the database..."
  # shellcheck disable=SC2016 # expands inside the container
  if ! (umask 077 && dc exec -T db sh -c 'pg_dump -Fc -U "$POSTGRES_USER" -d "$POSTGRES_DB"' >"$dump"); then
    rm -f "$dump"
    return 1
  fi
  entries=$(dc exec -T db pg_restore --list <"$dump" 2>/dev/null | grep -vc '^;' || true)
  if [ "${entries:-0}" -eq 0 ]; then
    warn "The backup at $dump could not be read back."
    rm -f "$dump"
    return 1
  fi
}

# Deletes all but the $KEEP_BACKUPS newest pre-update dumps. Their names hold
# a UTC timestamp, so the glob lists them oldest first.
prune_backups() {
  set -- "$BACKUP_DIR"/before-update-*.pgdump
  [ -e "$1" ] || return 0
  extra=$(($# - KEEP_BACKUPS))
  while [ "$extra" -gt 0 ]; do
    rm -f "$1"
    shift
    extra=$((extra - 1))
  done
}

# A value from $LAST_UPDATE.
last_update_get() {
  sed -n "s/^$1=//p" "$LAST_UPDATE" | tail -n 1
}

cmd_update() {
  latest=false
  for arg in "$@"; do
    case $arg in
      --latest) latest=true ;;
      *) die_usage "Unknown option for update: $arg" ;;
    esac
  done
  require_setup
  require_docker
  write_compose
  # What runs now, asked before --latest changes the tag.
  before=$(running_image_id)
  previous=$(running_version)
  if $latest; then
    # After a rollback BUKMARK_VERSION pins the older release; latest follows
    # new ones again. Exported too, so a value in the caller's environment
    # does not win over it for this run.
    if [ "$(env_get BUKMARK_VERSION)" != latest ]; then
      set_env BUKMARK_VERSION latest
      say "Set BUKMARK_VERSION=latest in $ENV_FILE"
    fi
    BUKMARK_VERSION=latest
    export BUKMARK_VERSION
  fi
  image=$(app_image)

  # Before the pull: the new version may change the database as it starts,
  # and this dump is the way back from that.
  dump=$BACKUP_DIR/before-update-$(date -u +%Y%m%dT%H%M%SZ).pgdump
  backup_database "$dump" ||
    die "The database backup failed (see above), so nothing was updated. Your data is as it was."
  say "Backed up the database to $dump"

  pulled=true
  pull_images || pulled=false
  changed=false
  if $pulled && [ "$before" != "$(image_id "$image")" ]; then
    changed=true
    # Recorded before the new version starts, so a failed start can still be
    # rolled back.
    tmp=$BACKUP_DIR/.last-update.$$
    printf 'version=%s\ndump=%s\n' "$previous" "$dump" >"$tmp"
    mv -f "$tmp" "$LAST_UPDATE"
    prune_backups
  else
    # Nothing changes, so nothing to roll back from; keep the record of the
    # update that did change something.
    rm -f "$dump"
  fi
  dc up -d --remove-orphans
  wait_healthy
  if ! $pulled; then
    say "bukmark is running at $(server_url), on the version it already had."
    # A BUKMARK_IMAGE build may exist only on this machine, where a failed
    # download is expected. For the published image it means no update.
    case $image in
      "$DEFAULT_IMAGE":*) die "Not updated: could not download $image." ;;
    esac
    return 0
  fi
  if ! $changed; then
    say "bukmark is up to date ($image), running at $(server_url)"
    pinned=${BUKMARK_VERSION:-$(env_get BUKMARK_VERSION)}
    case ${pinned:-latest} in
      latest) ;;
      *) say "BUKMARK_VERSION is set to $pinned. To follow new releases again: bukmark update --latest" ;;
    esac
    return 0
  fi
  say "bukmark is updated ($image), running at $(server_url)"
  say "The database from before the update is in $dump"
  if [ -n "$previous" ]; then
    say "To go back to $previous and that database: bukmark rollback"
  else
    say "The version from before the update is unknown, so bukmark rollback cannot pin it."
  fi
}

cmd_rollback() {
  yes=false
  for arg in "$@"; do
    case $arg in
      --yes | -y) yes=true ;;
      *) die_usage "Unknown option for rollback: $arg" ;;
    esac
  done
  require_setup
  [ -f "$LAST_UPDATE" ] ||
    die "Nothing to roll back to: no update has been recorded. bukmark update records one each time it installs a new version."
  previous=$(last_update_get version)
  dump=$(last_update_get dump)
  if [ -z "$dump" ] || [ ! -s "$dump" ]; then
    die "Nothing to roll back to: the backup from the last update (${dump:-none recorded}) is missing."
  fi
  [ -n "$previous" ] ||
    die "The version that ran before the last update is unknown, so bukmark cannot go back to it. The database from before it is in $dump"

  if ! $yes; then
    printf 'This puts back bukmark %s and the database as it was before the last update (%s).\nAnything saved since that update is lost.\nRoll back? [y/N] ' "$previous" "$dump" >&2
    answer=
    read -r answer || true
    case $answer in
      y | Y | yes | YES | Yes) ;;
      *) die "Nothing was changed." ;;
    esac
  fi

  require_docker
  write_compose
  # Exported, so the caller's environment cannot pick another version.
  BUKMARK_VERSION=$previous
  export BUKMARK_VERSION
  # Before anything is stopped: with no image for that version there is
  # nothing to roll back to, and the running server should stay up.
  pull_images || true
  set_env BUKMARK_VERSION "$previous"
  say "Set BUKMARK_VERSION=$previous in $ENV_FILE"

  dc stop app
  dc up -d --wait db ||
    die "The database did not start, so it was not restored. bukmark is stopped; start it again: bukmark start"
  say "Restoring the database from $dump..."
  # Emptied schemas first: pg_restore into tables the newer version changed
  # would fail or mix the two. That includes drizzle, where the server records
  # the migrations it applied: the dump brings back the older list, so the
  # newer version's migrations run again on the next update.
  # --exit-on-error stops at the first problem.
  # shellcheck disable=SC2016 # expands inside the container
  if ! dc exec -T db sh -c 'PGOPTIONS="-c client_min_messages=warning" psql -v ON_ERROR_STOP=1 -q -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "DROP SCHEMA IF EXISTS drizzle CASCADE; DROP SCHEMA public CASCADE; CREATE SCHEMA public;"' ||
    ! dc exec -T db sh -c 'pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner --exit-on-error' <"$dump"; then
    die "Restoring the database failed (see above). bukmark is stopped, so nothing more is changed. The backup is still in $dump"
  fi
  dc up -d --remove-orphans
  wait_healthy
  # Done: a second rollback would restore the same dump over newer changes.
  rm -f "$LAST_UPDATE"
  say "bukmark is back on $previous, with the database from before the update, running at $(server_url)"
  say "BUKMARK_VERSION stays at $previous, so bukmark update keeps it there. To follow new releases again: bukmark update --latest"
}

cmd_open() {
  require_setup
  url=$(server_url)
  case $(uname -s) in
    Darwin) opener=open ;;
    *) opener=xdg-open ;;
  esac
  if have "$opener" && "$opener" "$url" >/dev/null 2>&1; then
    say "Opened $url"
  else
    say "Open $url in your browser."
  fi
}

cmd_uninstall() {
  delete=false
  yes=false
  for arg in "$@"; do
    case $arg in
      --delete-data) delete=true ;;
      --yes | -y) yes=true ;;
      *) die_usage "Unknown option for uninstall: $arg" ;;
    esac
  done
  if [ ! -d "$DIR" ]; then
    say "Nothing to uninstall: $DIR does not exist."
    return 0
  fi
  if $delete && ! $yes; then
    printf 'This deletes all your bookmarks and bukmark settings, for good.\nType delete to confirm: ' >&2
    answer=
    read -r answer || true
    [ "$answer" = delete ] || die "Nothing was deleted."
  fi

  require_docker
  write_compose
  if $delete; then
    dc down --volumes --remove-orphans
    # Only the files bukmark wrote: BUKMARK_HOME may point at a folder that
    # holds other things too.
    rm -f "$COMPOSE_YML" "$OVERRIDE_YML" "$ENV_FILE" "$DIR"/.env.tmp.* "$DIR"/.compose.yml.*
    if rmdir "$DIR" 2>/dev/null; then
      say "Deleted bukmark, its data and $DIR."
    else
      say "Deleted bukmark and its data. $DIR has other files in it, so it is kept."
    fi
  else
    dc down --remove-orphans
    say "Removed bukmark's containers. Your bookmarks are kept in the Docker volume ${PROJECT}_pgdata, your settings in $DIR."
    say "Start it again: bukmark start. Delete everything: bukmark uninstall --delete-data"
  fi
  say "The bukmark command itself is still at $0. If Homebrew installed it: brew uninstall bukmark. If not, delete that file."
}

main() {
  if [ $# -eq 0 ]; then
    usage
    return 0
  fi
  cmd=$1
  shift
  case $cmd in
    setup) cmd_setup "$@" ;;
    start) no_options "$@"; cmd_start ;;
    stop) no_options "$@"; cmd_stop ;;
    restart) no_options "$@"; cmd_restart ;;
    status) no_options "$@"; cmd_status ;;
    logs) cmd_logs "$@" ;;
    update) cmd_update "$@" ;;
    rollback) cmd_rollback "$@" ;;
    open) no_options "$@"; cmd_open ;;
    uninstall) cmd_uninstall "$@" ;;
    version | --version | -v) say "bukmark $BUKMARK_CLI_VERSION" ;;
    help | --help | -h) usage ;;
    *)
      warn "Unknown command: $cmd"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
