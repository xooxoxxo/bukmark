# Copy to .env and edit. Every value below has a working default, so
# `docker compose up -d` works with no .env at all — .env is for changing them.

# Postgres password. Compose publishes the database on 127.0.0.1 only, so
# nothing outside this machine can reach it; that is what makes the default
# acceptable. Change it before you publish the database any wider.
POSTGRES_PASSWORD=bukmark

# Port the Postgres database is published on, on the host's 127.0.0.1.
# Change this only if you already run Postgres locally on 5432 and want to
# avoid conflict. The app always reaches it at db:5432 over the compose network.
POSTGRES_PORT=5432

# Port the API and web UI are served on, on the host.
PORT=3000

# Other web origins allowed to read API responses from a browser,
# comma-separated, e.g. http://localhost:5173 for a web dev server.
# Empty (the default) registers no CORS at all, which is what bukmark itself
# needs: the web app is same-origin, and the browser extension reaches the
# server through the host access you grant it, not through CORS.
# Never use a wildcard.
CORS_ORIGINS=

# true only when a reverse proxy (nginx, Caddy, Traefik) is the sole way to
# reach the app. The server then trusts X-Forwarded-Proto (the session cookie
# is marked Secure over https) and X-Forwarded-For (rate limits count each
# client, not the proxy). Anyone who reaches the port directly can forge them.
TRUST_PROXY=false

# Browser-extension builds the login page recognises, comma-separated:
# Chrome extension IDs and Firefox ID hashes. Empty (the default) knows only
# the official Firefox add-on. A client not in the list still gets Allow, with
# an "Unrecognised extension" warning. When you set this, include the official
# Firefox add-on's hash, 79d9f60576061d67a8a6a23ee099801cbdd1ceef, if you use it.
BUKMARK_EXTENSION_IDS=
