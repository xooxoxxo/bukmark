# Copy to .env and edit. Every value below has a working default, so
# `docker compose up -d` works with no .env at all — .env is for changing them.

# Postgres password. Change this if the database is reachable by anything but
# you; it is only a safe default because the stack binds to localhost.
POSTGRES_PASSWORD=bookmarkt

# Port the API and web UI are served on, on the host.
PORT=3000

# Browser-extension origins allowed to call the API, comma-separated.
# Empty (the default) registers no CORS at all, which is correct until you
# actually load the extension. Then put its origin here:
#   CORS_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# The API has NO authentication, so this list is the only thing limiting which
# pages a browser will let call it. Never use a wildcard.
CORS_ORIGINS=
