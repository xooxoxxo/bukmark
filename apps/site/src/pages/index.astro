---
// The landing page is intentionally independent from Starlight's docs layout.
import '../styles/custom.css';
import DemoApp from '../components/DemoApp.astro';

// What a shared link to the landing page shows: the promise, then what it is.
const SHARE = {
	title: 'bukmark — bookmarks you own',
	description:
		'A self-hosted bookmark manager. Save any page in one click, search the text of everything you saved, and sort it with AI. Open source; runs on your own server.',
	image: 'https://bukmark.it/og/home.png',
	alt: 'bukmark: Bookmarks you own. Save any page in one click. Search what you saved. Sort it with AI. Self-hosted, open source, for Chrome, Firefox and Safari.',
};

// The ways in, quickest first. All need Docker; the install guide has the rest.
// `live` turns a way in on once it works for anyone: the script and Homebrew
// need the first release (the published image and the formula in the tap).
const CHANNELS = [
	{
		id: 'script',
		label: 'Script',
		live: false,
		lines: ['curl -fsSL https://bukmark.it/install.sh | sh'],
		note: 'Needs Docker. Installs the bukmark command in your home folder, no sudo.',
	},
	{
		id: 'brew',
		label: 'Homebrew',
		live: false,
		lines: ['brew install xooxoxxo/tap/bukmark', 'bukmark setup'],
		note: 'Needs Docker Desktop, OrbStack or Colima.',
	},
	{
		id: 'docker',
		label: 'Docker',
		live: true,
		lines: ['git clone https://github.com/xooxoxxo/bukmark.git', 'cd bukmark', 'docker compose up -d'],
		note: 'Builds from source with Docker Compose.',
	},
];
const LIVE_CHANNELS = CHANNELS.filter((c) => c.live);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>bukmark — bookmarks you own</title>
		<meta name="description" content={SHARE.description} />
		<link rel="canonical" href="https://bukmark.it/" />
		<meta name="theme-color" content="#0e0f13" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="bukmark" />
		<meta property="og:url" content="https://bukmark.it/" />
		<meta property="og:title" content={SHARE.title} />
		<meta property="og:description" content={SHARE.description} />
		<meta property="og:image" content={SHARE.image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={SHARE.alt} />
		<meta property="og:locale" content="en" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={SHARE.title} />
		<meta name="twitter:description" content={SHARE.description} />
		<meta name="twitter:image" content={SHARE.image} />
		<meta name="twitter:image:alt" content={SHARE.alt} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<script is:inline>
			// The landing page is not a Starlight page, but it shares the theme with
			// the docs: read the key Starlight's own toggle writes so a choice made
			// in /docs carries over here. Inline and in <head> so the first paint is
			// already correct -- a flash of the wrong paper is worse than no toggle.
			try {
				const stored = localStorage.getItem('starlight-theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.dataset.theme = theme;
			} catch {
				// Private mode can throw on localStorage; the CSS media-query
				// fallback already covers this case.
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<header class="site-header">
			<a class="brand" href="/" aria-label="bukmark home">
				<img class="brand__logo" src="/logo-mark.svg" alt="" width="67" height="100" />
				<span>bukmark</span>
			</a>
			<nav aria-label="Primary navigation">
				<ul class="site-header__links">
					<li><a href="#workflow">How it works</a></li>
					<li><a href="/docs/install">Install</a></li>
					<li><a href="/docs/">Docs</a></li>
				</ul>
			</nav>
			<a class="button button--compact" href="https://github.com/xooxoxxo/bukmark">Star</a>
		</header>

		<main id="content">
			<section class="hero">
				<div class="frame reveal">
					<h1>Bookmarks you own.</h1>
					<div class="hero__lower">
						<div class="hero__intro">
							<p>
								Capture anything with one click. Sort deliberately with AI. Self-hosted,
								open source. No accounts. No lock-in.
							</p>
							<div class="button-row">
								<a class="button" href="https://github.com/xooxoxxo/bukmark">Star on GitHub</a>
								<a class="button button--outline" href="/docs/install">Get started</a>
							</div>
						</div>
						<div class="install-command" data-install>
							<div class="install__bar">
								<span class="install__label">Install</span>
								<div class="install__tabs" role="tablist" aria-label="How to install">
									{LIVE_CHANNELS.map((c, i) => (
										<button
											type="button"
											role="tab"
											id={`install-tab-${c.id}`}
											aria-controls={`install-${c.id}`}
											aria-selected={i === 0 ? 'true' : 'false'}
											tabindex={i === 0 ? 0 : -1}
										>
											{c.label}
										</button>
									))}
								</div>
							</div>
							{LIVE_CHANNELS.map((c, i) => (
								<div
									class="install__panel"
									role="tabpanel"
									id={`install-${c.id}`}
									aria-labelledby={`install-tab-${c.id}`}
									data-selected={i === 0 ? 'true' : 'false'}
								>
									<h3 class="install__panel-title">{c.label}</h3>
									<pre class="install__code"><code>{c.lines.map((line) => (
										<span class="install__line"><span class="install__prompt" aria-hidden="true">$ </span>{line}</span>
									))}</code></pre>
									<div class="install__foot">
										<p class="install__note">{c.note}</p>
										<button type="button" class="install__copy" data-copy={c.lines.join('\n')}>
											Copy
										</button>
									</div>
								</div>
							))}
							<ol class="install__next">
								<li>Open <code>localhost:3000</code> and set your password.</li>
								<li>Add the browser extension and log in.</li>
								<li>Save your first page.</li>
							</ol>
						</div>
					</div>
				</div>
			</section>

			<section class="workflow reveal" id="workflow">
				<div class="frame">
					<header class="section-heading">
						<h2>The three moves</h2>
						<p>Speed up capture. Batch your sorting. Own your export.</p>
					</header>
					<div class="workflow__list">
						<article class="workflow__item">
							<h3>Capture</h3>
							<p>
								Install the extension in Chrome, Edge, Firefox or Safari. The toolbar button saves
								the current page with an optional note; Alt+Shift+K (Control+Shift+K on a Mac) saves
								silently. On a phone, share to the web app or run an iOS Shortcut. Capture now;
								decide later.
							</p>
						</article>
						<article class="workflow__item">
							<h3>Sort with AI</h3>
							<p>
								Connect the MCP server and ask your assistant to sort your unsorted links. It proposes
								assignments to your existing hubs; you approve or reassign them in one batch.
								Sorting happens on your schedule, not at capture time.
							</p>
						</article>
						<article class="workflow__item">
							<h3>Export</h3>
							<p>
								Export HTML for any browser, JSON for backups, or CSV for spreadsheets. Export
								all links, one hub, or the current search. Your data leaves the way you want it.
							</p>
						</article>
					</div>
				</div>
			</section>

			<section class="product-view reveal">
				<div class="frame">
					<header class="product-view__intro">
						<h2>Unsorted is a feature.</h2>
						<p>
							Everything lands in one calm workbench. Hubs stay visible, filters stay close,
							and the unsorted queue waits until you choose to triage it.
						</p>
					</header>
					<figure>
						<DemoApp />
						<figcaption>
							A working demo with sample links. Filter by hub, search, or switch to the grid.
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="closing reveal">
				<div class="frame closing__grid">
					<h2>Capture now.<br />Sort when you choose.</h2>
					<div class="closing__action">
						<p>
							Run it on your own infrastructure. Keep the database. Export whenever you want.
						</p>
						<div class="button-row">
							<a class="button" href="/docs/install">Install locally</a>
							<a class="button button--outline" href="/docs/">Read the docs</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="frame site-footer__grid">
				<div>
					<a class="brand brand--footer" href="/" aria-label="bukmark home">
						<img class="brand__logo" src="/logo-mark.svg" alt="" width="67" height="100" />
						<span>bukmark</span>
					</a>
					<p>Self-hosted bookmark triage. Open source and built to leave.</p>
				</div>
				<div class="site-footer__details">
					<p>Postgres · Docker · MCP</p>
					<p>
						<a href="https://github.com/xooxoxxo/bukmark">GitHub</a>
						<a href="https://github.com/xooxoxxo/bukmark/blob/main/LICENSE">MIT license</a>
						<a href="/docs/">Documentation</a>
						<a href="/docs/privacy/">Privacy</a>
					</p>
				</div>
			</div>
		</footer>

		<script>
			document.documentElement.classList.add('js');

			// Install card: arrow keys move between the tabs, as the ARIA tabs pattern expects.
			for (const card of document.querySelectorAll<HTMLElement>('[data-install]')) {
				const tabs = [...card.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
				const select = (tab: HTMLButtonElement, focus = false) => {
					for (const t of tabs) {
						const on = t === tab;
						t.setAttribute('aria-selected', String(on));
						t.tabIndex = on ? 0 : -1;
						card.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)?.setAttribute('data-selected', String(on));
					}
					if (focus) tab.focus();
				};
				tabs.forEach((tab, i) => {
					tab.addEventListener('click', () => select(tab));
					tab.addEventListener('keydown', (e) => {
						const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
						if (step) select(tabs[(i + step + tabs.length) % tabs.length]!, true);
					});
				});
				for (const button of card.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
					button.addEventListener('click', async () => {
						try {
							await navigator.clipboard.writeText(button.dataset.copy ?? '');
						} catch {
							return;
						}
						button.textContent = 'Copied';
						button.dataset.copied = '';
						setTimeout(() => {
							button.textContent = 'Copy';
							delete button.dataset.copied;
						}, 1600);
					});
				}
			}
			const targets = document.querySelectorAll<HTMLElement>('.reveal');
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reducedMotion || !('IntersectionObserver' in window)) {
				targets.forEach((target) => target.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.08, rootMargin: '0px 0px -48px 0px' }
				);
				targets.forEach((target) => observer.observe(target));
			}
		</script>

		<style is:global>
			html { overflow-x: clip; scroll-behavior: smooth; }
			* { box-sizing: border-box; }
			body {
				overflow-x: clip;
				margin: 0;
				background: var(--bk-paper);
				color: var(--bk-ink);
				font-family: var(--bk-font-body);
				font-size: var(--bk-text-base);
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
			}
			::selection { background: var(--bk-accent); color: var(--bk-paper); }
			.skip-link {
				position: fixed;
				top: var(--bk-space-md);
				left: var(--bk-space-md);
				z-index: 20;
				padding: var(--bk-space-sm) var(--bk-space-md);
				border: 2px solid var(--bk-ink);
				background: var(--bk-paper);
				color: var(--bk-ink);
				font-family: var(--bk-font-display);
				font-weight: 700;
				transform: translateY(calc(-100% - 2rem));
			}
			.skip-link:focus { transform: none; }
			.frame { width: min(100%, 100rem); margin-inline: auto; }
			.site-header {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto auto;
				align-items: center;
				gap: clamp(1rem, 3vw, 3rem);
				height: var(--bk-header-h);
				padding: 0 clamp(1.25rem, 4vw, 4rem);
				border-bottom: 2px solid var(--bk-ink);
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: var(--bk-space-xs);
				width: fit-content;
				color: var(--bk-ink);
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-lg);
				font-weight: 800;
				letter-spacing: -0.02em;
				text-decoration: none;
			}
			.brand__logo { display: block; width: auto; height: 1.9rem; }
			.site-header__links {
				display: flex;
				align-items: center;
				gap: clamp(1rem, 2.5vw, 2.5rem);
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.site-header__links a,
			.site-footer a {
				color: var(--bk-ink);
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-sm);
				font-weight: 700;
				text-decoration: underline;
				text-decoration-color: transparent;
				text-underline-offset: 0.28em;
				transition: color var(--bk-dur-micro) var(--bk-ease-out), text-decoration-color var(--bk-dur-micro) var(--bk-ease-out);
			}
			.site-header__links a:hover,
			.site-footer a:hover { color: var(--bk-accent); text-decoration-color: currentColor; }
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 3.25rem;
				padding: var(--bk-space-sm) var(--bk-space-xl);
				border: 2px solid var(--bk-ink);
				background: var(--bk-ink);
				color: var(--bk-paper);
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-sm);
				font-weight: 700;
				letter-spacing: 0.02em;
				text-align: center;
				text-decoration: none;
				white-space: nowrap;
				transition: background var(--bk-dur-short) var(--bk-ease-out), border-color var(--bk-dur-short) var(--bk-ease-out), color var(--bk-dur-short) var(--bk-ease-out), transform var(--bk-dur-short) var(--bk-ease-out);
			}
			.button:hover { border-color: var(--bk-accent); background: var(--bk-accent); color: var(--bk-paper); transform: translateY(-2px); }
			.button:active { transform: none; }
			.button--outline { background: transparent; color: var(--bk-ink); }
			.button--compact { min-height: 2.75rem; padding-inline: var(--bk-space-lg); }
			:is(a, button):focus-visible { outline: 2px solid var(--bk-accent); outline-offset: 4px; }
			.hero,
			.workflow,
			.product-view,
			.closing { border-bottom: 2px solid var(--bk-ink); }
			.hero { padding: clamp(4rem, 9vw, 9rem) clamp(1.25rem, 4vw, 4rem) clamp(4rem, 8vw, 8rem); }
			.hero h1 {
				max-width: 14ch;
				margin: 0;
				font-family: var(--bk-font-display);
				font-size: clamp(4.5rem, 9.2vw, 9.25rem);
				font-weight: 800;
				letter-spacing: -0.065em;
				line-height: 0.86;
				text-wrap: balance;
			}
			.hero__lower {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: clamp(2rem, 5vw, 6rem);
				align-items: start;
				margin-top: clamp(4rem, 9vw, 9rem);
				padding-top: var(--bk-space-xl);
				border-top: 2px solid var(--bk-ink);
			}
			.hero__intro { grid-column: 1 / 6; }
			.hero__intro > p {
				max-width: 34ch;
				margin: 0 0 var(--bk-space-xl);
				font-size: clamp(1.35rem, 2.3vw, 2.25rem);
				line-height: 1.2;
				text-wrap: pretty;
			}
			.button-row { display: flex; flex-wrap: wrap; gap: var(--bk-space-md); }
			.install-command { grid-column: 7 / -1; }
			/* The install card: one orange bar to pick a way in, the commands on the
			   page's own paper, and the three steps after. Orange text on a dark bar
			   would fail contrast in dark mode, so the bar's ink is fixed. */
			.install-command {
				min-width: 0;
				border: 2px solid var(--bk-ink);
				background: var(--bk-paper);
			}
			.install__bar {
				display: flex;
				flex-wrap: wrap;
				align-items: stretch;
				justify-content: space-between;
				gap: var(--bk-space-xs) var(--bk-space-md);
				padding: var(--bk-space-xs) var(--bk-space-xs) var(--bk-space-xs) var(--bk-space-md);
				border-bottom: 2px solid var(--bk-ink);
				background: var(--bk-accent);
				color: #0e0f13;
			}
			.install__label {
				align-self: center;
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-sm);
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.install__tabs { display: flex; flex-wrap: wrap; gap: 2px; }
			.install__tabs button {
				min-height: 2.5rem;
				padding: 0 var(--bk-space-md);
				border: 2px solid transparent;
				background: transparent;
				color: #0e0f13;
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-sm);
				font-weight: 800;
				cursor: pointer;
			}
			.install__tabs button:hover { border-color: #0e0f13; }
			.install__tabs button[aria-selected='true'] { border-color: #0e0f13; background: #0e0f13; color: #fbf7f3; }
			.install__tabs button:focus-visible { outline: 2px solid #0e0f13; outline-offset: 2px; }
			.install__panel { padding: var(--bk-space-lg) var(--bk-space-lg) var(--bk-space-md); }
			/* Without script every way in shows, one after another, each under its name. */
			.install__panel + .install__panel { border-top: 1px solid var(--bk-rule); }
			.js .install__panel + .install__panel { border-top: 0; }
			.js .install__panel[data-selected='false'] { display: none; }
			.install__panel-title {
				margin: 0 0 var(--bk-space-sm);
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-xs);
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.js .install__panel-title { display: none; }
			.install__code {
				margin: 0;
				font-family: var(--bk-font-mono);
				font-size: clamp(0.8125rem, 1.05vw, 0.9375rem);
				line-height: 1.7;
				white-space: pre-wrap;
				overflow-wrap: anywhere;
			}
			.install__line { display: block; padding-left: 1.4em; text-indent: -1.4em; }
			.install__prompt { color: var(--bk-accent); font-weight: 700; user-select: none; }
			.install__foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--bk-space-md);
				margin-top: var(--bk-space-md);
			}
			.install__note { margin: 0; color: var(--bk-muted); font-size: var(--bk-text-xs); }
			.install__copy {
				flex-shrink: 0;
				min-height: 2.25rem;
				padding: 0 var(--bk-space-md);
				border: 2px solid var(--bk-ink);
				background: transparent;
				color: var(--bk-ink);
				font-family: var(--bk-font-display);
				font-size: var(--bk-text-xs);
				font-weight: 800;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				cursor: pointer;
				transition: background-color var(--bk-dur-micro) var(--bk-ease-out), color var(--bk-dur-micro) var(--bk-ease-out);
			}
			.install__copy:hover { border-color: var(--bk-accent); color: var(--bk-accent); }
			.install__copy[data-copied] { border-color: var(--bk-accent); background: var(--bk-accent); color: #0e0f13; }
			.install__copy:focus-visible { outline: 2px solid var(--bk-accent); outline-offset: 2px; }
			.install__next {
				display: grid;
				gap: var(--bk-space-xs);
				margin: 0;
				padding: var(--bk-space-md) var(--bk-space-lg) var(--bk-space-lg);
				border-top: 2px solid var(--bk-ink);
				counter-reset: step;
				list-style: none;
				font-size: var(--bk-text-sm);
			}
			.install__next li { display: flex; gap: var(--bk-space-sm); counter-increment: step; }
			.install__next li::before {
				content: counter(step);
				flex-shrink: 0;
				width: 1.5em;
				color: var(--bk-accent);
				font-family: var(--bk-font-display);
				font-weight: 800;
			}
			.install__next code { padding: 0; background: none; font-family: var(--bk-font-mono); font-size: 0.95em; }
			.workflow,
			.product-view,
			.closing { padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 4vw, 4rem); }
			.section-heading,
			.product-view__intro {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: var(--bk-space-xl);
				align-items: start;
				margin-bottom: clamp(4rem, 8vw, 8rem);
			}
			.section-heading h2,
			.product-view__intro h2 {
				grid-column: 1 / 9;
				margin: 0;
				font-family: var(--bk-font-display);
				font-size: clamp(3.5rem, 7vw, 7.5rem);
				font-weight: 800;
				letter-spacing: -0.055em;
				line-height: 0.9;
				text-wrap: balance;
			}
			.section-heading > p,
			.product-view__intro > p {
				grid-column: 9 / -1;
				margin: 0;
				color: var(--bk-muted);
				font-size: var(--bk-text-md);
				line-height: 1.55;
				text-wrap: pretty;
			}
			.workflow__list { border-top: 2px solid var(--bk-ink); }
			.workflow__item {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: var(--bk-space-xl);
				align-items: start;
				padding: clamp(2.5rem, 5vw, 5rem) 0;
				border-bottom: 2px solid var(--bk-ink);
			}
			.workflow__item h3 {
				grid-column: 1 / 7;
				margin: 0;
				font-family: var(--bk-font-display);
				font-size: clamp(2.75rem, 5.5vw, 6rem);
				font-weight: 800;
				letter-spacing: -0.045em;
				line-height: 0.92;
				text-wrap: balance;
			}
			.workflow__item p {
				grid-column: 8 / -1;
				margin: 0;
				max-width: 50ch;
				color: var(--bk-muted);
				font-size: var(--bk-text-md);
				line-height: 1.65;
				text-wrap: pretty;
			}
			.workflow__item:nth-child(2) h3 { grid-column: 7 / -1; text-align: right; }
			.workflow__item:nth-child(2) p { grid-column: 1 / 6; grid-row: 1; }
			.workflow__item:last-child { border-bottom: 0; }
			.product-view figure { margin: 0; }
			.product-view figcaption { padding-top: var(--bk-space-sm); color: var(--bk-muted); font-size: var(--bk-text-sm); }
			.closing__grid {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: clamp(2rem, 6vw, 7rem);
				align-items: start;
			}
			.closing h2 {
				grid-column: 1 / 9;
				margin: 0;
				font-family: var(--bk-font-display);
				font-size: clamp(3.75rem, 8vw, 8.5rem);
				font-weight: 800;
				letter-spacing: -0.06em;
				line-height: 0.88;
			}
			.closing__action { grid-column: 9 / -1; }
			.closing__action > p { margin: 0 0 var(--bk-space-xl); color: var(--bk-muted); font-size: var(--bk-text-md); line-height: 1.55; }
			.site-footer { padding: clamp(3rem, 6vw, 6rem) clamp(1.25rem, 4vw, 4rem); }
			.site-footer__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--bk-space-2xl); }
			.brand--footer { margin-bottom: var(--bk-space-lg); }
			.site-footer p { margin: 0; max-width: 42ch; color: var(--bk-muted); font-size: var(--bk-text-sm); }
			.site-footer__details { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; text-align: right; }
			.site-footer__details p:last-child { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--bk-space-lg); }
			.js .reveal { opacity: 0; transform: translateY(8px); transition: opacity var(--bk-dur-long) var(--bk-ease-out), transform var(--bk-dur-long) var(--bk-ease-out); }
			.js .reveal.is-visible { opacity: 1; transform: none; }

			@media (max-width: 64rem) {
				.hero__intro { grid-column: 1 / 7; }
				.install-command { grid-column: 7 / -1; }
				.section-heading h2,
				.product-view__intro h2,
				.closing h2 { grid-column: 1 / 8; }
				.section-heading > p,
				.product-view__intro > p,
				.closing__action { grid-column: 8 / -1; }
			}
			@media (max-width: 48rem) {
				.site-header { grid-template-columns: minmax(0, 1fr) auto; }
				.site-header nav { display: none; }
				.brand { font-size: var(--bk-text-md); }
				.brand__logo { height: 1.55rem; }
				.button { width: 100%; }
				.button--compact { width: auto; }
				.hero h1 { max-width: none; font-size: clamp(3.2rem, 16vw, 5.5rem); line-height: 0.9; }
				.hero__lower,
				.section-heading,
				.product-view__intro,
				.workflow__item,
				.closing__grid,
				.site-footer__grid { display: block; }
				.hero__intro,
				.install-command,
				.section-heading h2,
				.section-heading > p,
				.product-view__intro h2,
				.product-view__intro > p,
				.workflow__item h3,
				.workflow__item p,
				.workflow__item:nth-child(2) h3,
				.workflow__item:nth-child(2) p,
				.closing h2,
				.closing__action { grid-column: auto; grid-row: auto; }
				.workflow__item:nth-child(2) h3 { text-align: left; }
				.hero__intro { margin-bottom: var(--bk-space-2xl); }
				.button-row { flex-direction: column; }
				.section-heading h2,
				.product-view__intro h2 { margin-bottom: var(--bk-space-xl); font-size: clamp(3rem, 15vw, 5.25rem); }
				.workflow__item h3 { margin-bottom: var(--bk-space-xl); font-size: clamp(2.75rem, 13vw, 4.5rem); }
				.closing h2 { margin-bottom: var(--bk-space-2xl); font-size: clamp(3rem, 14vw, 5rem); }
				.site-footer__details { align-items: flex-start; margin-top: var(--bk-space-2xl); text-align: left; }
				.site-footer__details p:last-child { justify-content: flex-start; margin-top: var(--bk-space-lg); }
			}
			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				*, *::before, *::after { transition-duration: 0.01ms !important; }
				.js .reveal { opacity: 1; transform: none; }
			}
			/* Printing never scrolls, so the observer that clears .reveal never
			   fires and every section below the fold would come out blank. */
			@media print {
				.js .reveal { opacity: 1; transform: none; }
			}
		</style>
	</body>
</html>
