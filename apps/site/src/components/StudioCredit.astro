---
// Who makes bukmark: one quiet line in the footer, with the studio's name in
// the accent so it still catches the eye.
interface Props {
	/** In the docs it stands alone below the content and needs its own rule and gutter. */
	standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<p class:list={['studio-credit', { 'studio-credit--standalone': standalone }]}>
	Made by <a class="studio-credit__mark" href="https://xo.vision">XO Vision</a>,{' '}
	<a class="studio-credit__parent" href="https://jovian.company">a Jovian division <span aria-hidden="true">→</span></a>
</p>

<style>
	/* Classes are doubled throughout: the landing page's global `.site-footer a`
	   would win otherwise. */
	.studio-credit {
		margin: 0;
		color: var(--bk-muted);
		font-family: var(--bk-font-display);
		font-size: var(--bk-text-sm);
		font-weight: 700;
	}

	.studio-credit.studio-credit--standalone {
		/* Above the docs' fixed table-of-contents pane, whose border would
		   otherwise run through the line. */
		position: relative;
		z-index: 2;
		/* Starlight's content gutter, so it lines up with the page text. */
		padding: var(--bk-space-lg) var(--sl-content-pad-x, 1.5rem);
		border-top: 2px solid var(--bk-rule);
		background: var(--bk-paper);
	}

	.studio-credit .studio-credit__mark,
	.studio-credit .studio-credit__parent {
		font-size: inherit;
		text-underline-offset: 0.25em;
		transition:
			color var(--bk-dur-micro) var(--bk-ease-out),
			text-decoration-color var(--bk-dur-micro) var(--bk-ease-out);
	}

	/* The studio: accent, underlined. */
	.studio-credit .studio-credit__mark {
		color: var(--bk-accent);
		text-decoration: underline 2px;
		text-decoration-color: currentColor;
	}

	.studio-credit .studio-credit__mark:hover {
		color: var(--bk-ink);
	}

	/* The parent: ink, a dotted underline. */
	.studio-credit .studio-credit__parent {
		color: var(--bk-ink);
		text-decoration: underline dotted 2px;
		text-decoration-color: var(--bk-rule);
		white-space: nowrap;
	}

	.studio-credit .studio-credit__parent:hover {
		color: var(--bk-accent);
		text-decoration-color: currentColor;
	}

	.studio-credit a:focus-visible {
		outline: 2px solid var(--bk-accent);
		outline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.studio-credit a {
			transition: none;
		}
	}
</style>
