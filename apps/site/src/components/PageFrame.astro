---
// Starlight's page frame, with the studio bar at the foot of the main area:
// full width beside the sidebar, below the content and the table of contents.
import Default from '@astrojs/starlight/components/PageFrame.astro';
import StudioBar from './StudioBar.astro';
---

<Default>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
	<StudioBar />
</Default>
