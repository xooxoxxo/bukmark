---
// Who makes bukmark, at the foot of every page: a black bar in both themes,
// so it reads as the studio's mark rather than part of the page.
---

<div class="studio-bar">
	<p>
		<a href="https://xo.vision">XO Vision</a>, a <a href="https://jovian.company">Jovian</a> division
	</p>
</div>

<style>
	.studio-bar {
		/* Above the docs' fixed table-of-contents pane, whose border would
		   otherwise run through the bar. */
		position: relative;
		z-index: 2;
		padding: 0.875rem clamp(1.25rem, 4vw, 4rem);
		/* On the dark theme the paper is near-black too: the rule marks the bar. */
		border-top: 2px solid var(--bk-ink);
		background: #0e0f13;
		color: #fbf7f3;
		font-family: var(--bk-font-body);
		font-size: var(--bk-text-sm);
		line-height: 1.5;
		text-align: center;
	}

	.studio-bar p {
		margin: 0;
	}

	.studio-bar a {
		color: #fbf7f3;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.25em;
		transition:
			color var(--bk-dur-short) var(--bk-ease-out),
			text-decoration-color var(--bk-dur-short) var(--bk-ease-out);
	}

	.studio-bar a:hover {
		color: var(--bk-accent);
		text-decoration-color: currentColor;
	}

	.studio-bar a:focus-visible {
		outline: 2px solid var(--bk-accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.studio-bar a {
			transition: none;
		}
	}
</style>
