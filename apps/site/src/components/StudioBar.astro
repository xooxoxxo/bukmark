---
// Who makes bukmark, at the foot of every page: a black band in both themes,
// so it reads as the studio's mark rather than part of the page.
---

<div class="studio-bar">
	<a class="studio-bar__mark" href="https://xo.vision">XO Vision</a>
	<a class="studio-bar__parent" href="https://jovian.company">a Jovian division <span aria-hidden="true">→</span></a>
</div>

<style>
	.studio-bar {
		/* Above the docs' fixed table-of-contents pane, whose border would
		   otherwise run through the bar. */
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--bk-space-lg) var(--bk-space-2xl);
		padding: clamp(3rem, 7vw, 6.5rem) clamp(1.25rem, 4vw, 4rem) clamp(2rem, 4vw, 3.5rem);
		/* On the dark theme the paper is near-black too: the rule marks the band. */
		border-top: 2px solid var(--bk-ink);
		background: #0e0f13;
		color: #fbf7f3;
	}

	.studio-bar a {
		color: #fbf7f3;
		text-decoration: underline;
		text-decoration-color: transparent;
		transition:
			color var(--bk-dur-short) var(--bk-ease-out),
			text-decoration-color var(--bk-dur-short) var(--bk-ease-out);
	}

	.studio-bar a:hover {
		color: var(--bk-accent);
		text-decoration-color: currentColor;
	}

	.studio-bar a:focus-visible {
		outline: 2px solid var(--bk-accent);
		outline-offset: 4px;
	}

	.studio-bar__mark {
		font-family: var(--bk-font-display);
		font-size: clamp(3.5rem, 11vw, 10rem);
		font-weight: 700;
		letter-spacing: -0.055em;
		line-height: 0.88;
		text-decoration-thickness: 0.06em;
		text-underline-offset: 0.08em;
	}

	.studio-bar__parent {
		font-family: var(--bk-font-display);
		font-size: clamp(1.125rem, 1.6vw, 1.5rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.25em;
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.studio-bar a {
			transition: none;
		}
	}
</style>
